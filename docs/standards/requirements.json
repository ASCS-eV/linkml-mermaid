      "id": "STATE-NOTES",
      "standard": "mermaid-statediagram",
      "clause": "Notes",
      "anchor": "notes",
      "requirement": "note left of | right of {id} : text.",
      "implemented": true,
      "code": "src/linkml_mermaid/state_diagram.py::StateDiagramRenderer.render",
      "tests": [
        "tests/test_state_diagram.py::TestStateDiagramNotes"
      ],
      "note": "Only the single-line form. The multi-line 'note right of X\\n ... \\nend note' block form is not emitted."
    },
    {
      "id": "STATE-COMPOSITE",
      "standard": "mermaid-statediagram",
      "clause": "Composite states",
      "anchor": "composite-states",
      "requirement": "state X { ... } nests a state machine inside a state.",
      "implemented": false,
      "reason": "MermaidState has no child-state slot, so there is nothing in the data model to nest. Adding it would change the public type."
    },
    {
      "id": "STATE-CHOICE",
      "standard": "mermaid-statediagram",
      "clause": "Choice",
      "anchor": "choice",
      "requirement": "state X <<choice>> models a branch point.",
      "implemented": false,
      "reason": "Not represented in the data model; a LinkML schema expresses the same thing as guarded transitions, which are supported."
    },
    {
      "id": "STATE-FORK",
      "standard": "mermaid-statediagram",
      "clause": "Forks",
      "anchor": "forks",
      "requirement": "state X <<fork>> / <<join>> model concurrent splits.",
      "implemented": false,
      "reason": "Not represented in the data model."
    },
    {
      "id": "STATE-CONCURRENCY",
      "standard": "mermaid-statediagram",
      "clause": "Concurrency",
      "anchor": "concurrency",
      "requirement": "-- separates concurrent regions inside a composite state.",
      "implemented": false,
      "reason": "Depends on composite states, which are not implemented."
    },
    {
      "id": "STATE-CLASSDEF",
      "standard": "mermaid-statediagram",
      "clause": "Styling with classDefs",
      "anchor": "styling-with-classdefs",
      "requirement": "classDef and class statements style states.",
      "implemented": false,
      "reason": "Styling is a presentation concern the caller can append to the rendered output."
    },
