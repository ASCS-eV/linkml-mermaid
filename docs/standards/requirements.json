      "standard": "mermaid-flowchart",
      "clause": "Open links",
      "anchor": "an-open-link",
      "requirement": "A link may be drawn without an arrow head: A --- B, A -.- B, A === B.",
      "implemented": false,
      "reason": "Every edge this package emits is directed, so an undirected link would misrepresent the data. FlowchartEdge has no arrow parameter."
    },
