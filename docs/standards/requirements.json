      "implemented": true,
      "code": "src/linkml_mermaid/flowchart.py::_SHAPE_BRACKETS",
      "tests": [
        "tests/test_flowchart.py::TestFlowchartNodes",
        "tests/test_spec_regressions.py::TestNodeShapeValidation"
      ]
    },
    {
      "id": "FLOW-ESCAPE",
      "standard": "mermaid-flowchart",
      "clause": "Entity codes to escape characters",
      "anchor": "entity-codes-to-escape-characters",
      "requirement": "Characters that break syntax are escaped as #NNN; or by HTML character name; # itself is #35;.",
      "implemented": true,
      "code": "src/linkml_mermaid/escaping.py::escape_mermaid_text",
      "tests": [
        "tests/test_escaping.py::TestEscapeMermaidText",
        "tests/test_spec_regressions.py::TestFlowchartLabelEscaping"
      ]
