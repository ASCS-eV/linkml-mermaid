    {
      "id": "FLOW-NODE-DEFAULT",
      "standard": "mermaid-flowchart",
      "clause": "A node (default)",
      "anchor": "a-node-default",
      "requirement": "A bare identifier declares a node with no text.",
      "implemented": true,
      "code": "src/linkml_mermaid/flowchart.py::_render_node_declaration",
      "tests": [
        "tests/test_flowchart.py::TestFlowchartNodes",
        "tests/test_spec_regressions.py::TestNodeShapeValidation::test_plain_rect_node_still_uses_bare_form"
      ]
    },
    {
      "id": "FLOW-NODE-TEXT",
      "standard": "mermaid-flowchart",
      "clause": "A node with text",
      "anchor": "a-node-with-text",
