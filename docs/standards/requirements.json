      "implemented": true,
      "code": "src/linkml_mermaid/flowchart.py::_render_edge",
      "tests": [
        "tests/test_flowchart.py::TestFlowchartEdges"
      ]
    },
    {
      "id": "FLOW-DIRECTION",
      "standard": "mermaid-flowchart",
      "clause": "Direction",
      "anchor": "direction",
      "requirement": "TB, TD, BT, RL, LR declared on the flowchart statement.",
      "implemented": true,
      "code": "src/linkml_mermaid/flowchart.py::FlowchartRenderer.__init__",
      "tests": [
        "tests/test_flowchart.py::TestFlowchartDeclaration"
      ]
